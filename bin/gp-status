#!/usr/bin/env bash
# Show whether gpclient is running, its session end, tunnel address and DNS routing. Needs no root;
# the session end comes from the root-only background log, read with sudo when it needs no password.
# Exits 0 when connected, 1 when not.
set -uo pipefail

cols=${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}
(( cols > 40 )) || cols=40

# show LABEL VALUE [INDENT]: value in a column, wrapped to the terminal width with a hanging indent
show() {
    local pad indent=${3-  }
    pad=$(printf '%18s' '')
    printf '%s\n' "$2" | fmt -w $((cols - 18)) |
        sed "1s/^/$(printf '%s%-*s' "$indent" $((18 - ${#indent})) "$1:")/; 2,\$s/^/$pad/"
}

pid=$(pgrep -x gpclient | head -1)
if [[ -z $pid ]]; then
    show gpclient "not running" ""
    exit 1
fi
show gpclient running ""
show pid "$pid"
show uptime "$(ps -o etime= -p "$pid" | tr -d ' ')"

log=/var/log/gpclient.log
grep_log=(grep)
[[ -r $log ]] || grep_log=(sudo -n grep)
now=$(date +%s)
if expires=$("${grep_log[@]}" -o 'user_expires=[0-9]\+' "$log" 2>/dev/null) &&
    expires=${expires##*=} && (( expires > now )); then
    left=$((expires - now))
    show "session end" "$(date -d "@$expires" '+%a %H:%M') (in $((left / 3600))h $((left % 3600 / 60))m)"
elif [[ -e $log && ! -r $log ]] && ! sudo -n true 2>/dev/null; then
    show "session end" "unknown, $log needs sudo"
fi

tuns=$(ip -o link show type tun | awk -F': ' '{print $2}')
[[ -n $tuns ]] || { show tunnel "none yet" ""; exit 1; }
for dev in $tuns; do
    show "$dev" "$(ip -br addr show dev "$dev" | awk '{$1 = $2 = ""; sub(/^ +/, ""); print}')" ""
    for what in dns domain default-route; do
        show "$what" "$(resolvectl "$what" "$dev" 2>/dev/null | sed 's/^[^:]*: *//' | tr -s ' \n' ' ')"
    done
done
