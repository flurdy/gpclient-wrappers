#!/bin/sh
# vpnc-script wrapper for gpclient --script: stock behaviour, then send only the VPN-pushed domains
# (not "~.", everything) to the VPN's DNS servers. GP_DNS_EXTRA_DOMAINS (comma or space separated)
# adds domains the VPN does not push. GP_ROUTE_EXTRA (IPv4 CIDRs, comma or space separated) adds
# routes through the tunnel when the gateway is split. Runs as root, needs systemd-resolved.

# shellcheck disable=SC2154  # CISCO_SPLIT_INC comes from gpclient
if [ "${CISCO_SPLIT_INC:-0}" -gt 0 ]; then
    for r in $(echo "${GP_ROUTE_EXTRA:-}" | tr ',' ' '); do
        case $r in */*) ;; *) r=$r/32 ;; esac
        export "CISCO_SPLIT_INC_${CISCO_SPLIT_INC}_ADDR=${r%/*}" "CISCO_SPLIT_INC_${CISCO_SPLIT_INC}_MASKLEN=${r#*/}"
        CISCO_SPLIT_INC=$((CISCO_SPLIT_INC + 1))
    done
    export CISCO_SPLIT_INC
fi

/etc/vpnc/vpnc-script "$@"
rc=$?

# shellcheck disable=SC2154,SC2086  # reason/TUNDEV come from gpclient; word splitting is intended
case $reason in
connect|reconnect)
    domains=$(resolvectl domain "$TUNDEV" | sed 's/^Link [0-9]* ([^)]*): *//')
    routes=
    for d in $domains; do
        [ "$d" = "~." ] && continue
        routes="$routes ~${d#\~}"
    done
    for d in $(echo "${GP_DNS_EXTRA_DOMAINS:-}" | tr ',' ' '); do
        routes="$routes ~${d#\~}"
    done
    resolvectl domain "$TUNDEV" $routes
    resolvectl default-route "$TUNDEV" no
    ;;
esac
exit $rc
